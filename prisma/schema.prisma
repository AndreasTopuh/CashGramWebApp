
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  expenses       Expense[]
  telegramUser   TelegramUser?
  categories     Category[]
  budgetPeriods  BudgetPeriod[]
  savings        Savings[]
  
  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#3B82F6") // Default blue color
  icon      String   @default("💰")      // Default money icon
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Foreign Keys
  userId    String
  
  // Relations
  expenses         Expense[]
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetAllocations BudgetAllocation[]
  
  @@unique([name, userId])
  @@map("categories")
}

model Expense {
  id          String   @id @default(cuid())
  amount      Float
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Foreign Keys
  userId      String
  categoryId  String
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@map("expenses")
}

model TelegramUser {
  id         String   @id @default(cuid())
  telegramId String   @unique
  userId     String   @unique
  token      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relations
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("telegram_users")
}

model BudgetPeriod {
  id          String   @id @default(cuid())
  userId      String
  name        String   // e.g., "September 2024"
  totalBudget Float    // Total monthly allowance
  startDate   DateTime // e.g., 10 September
  endDate     DateTime // e.g., 10 October
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetAllocations BudgetAllocation[]
  
  @@unique([userId, startDate])
  @@map("budget_periods")
}

model BudgetAllocation {
  id              String   @id @default(cuid())
  budgetPeriodId  String
  categoryId      String
  allocatedAmount Float    // Amount allocated for this category
  spentAmount     Float    @default(0) // Amount spent so far
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  budgetPeriod BudgetPeriod @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@unique([budgetPeriodId, categoryId])
  @@map("budget_allocations")
}

model Savings {
  id              String   @id @default(cuid())
  userId          String
  amount          Float
  fromPeriodId    String   // Which budget period this saving came from
  description     String?  // e.g., "Sisa budget September 2024"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("savings")
}
